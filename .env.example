# =====================================================
#  Configuración requerida en Dokploy (Environment)
# =====================================================
# En Dokploy → tu service → Environment → pegá estas vars.
# NO subir el .env real al repo.

# URL pooled de Neon (la que da Neon Console → "Pooled connection")
# NO usar la URL con channel_binding=require (rompe Prisma).
DATABASE_URL="postgresql://USER:PASS@HOST-POOLER.c-REGION.aws.neon.tech/DB?sslmode=require"

# Secreto único para firmar las sesiones del panel de administración.
# Generá uno nuevo para cada entorno (por ejemplo: openssl rand -base64 48).
# No reutilices este valor ni lo subas al repositorio.
AUTH_SECRET=""
